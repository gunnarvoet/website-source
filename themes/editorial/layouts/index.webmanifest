{{/* Academic's own index.webmanifest resizes the site icon it finds in
     static/img/, which is still the old photograph, and reads its colors from
     a Scratch the Academic shell fills in and this one does not, so it emitted
     "<no value>" for both. This copy names the monogram and the tile color
     directly. Editorial precedes Academic in the theme list, so it wins. */}}
{{- $author := partial "func/author.html" . -}}
{
  "name": "{{ $author.Params.name }}",
  "short_name": "{{ $author.Params.name }}",
  "lang": "{{ site.Language.Locale }}",
  "theme_color": "#0f2b33",
  "background_color": "#f2f0ea",
  "icons": [
    {
      "src": "{{ "icons/icon.svg" | relURL }}",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "{{ "icons/icon-192.png" | relURL }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ "icons/icon-512.png" | relURL }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "display": "standalone",
  "start_url": "{{ "/" | relLangURL }}"
}
