@article{cimolietal26,
  title = {Climatic Reach of Small-Scale Turbulence in the Ocean Interior},
  author = {Cimoli, Laura and Mashayek, Ali and Naveira Garabato, Alberto C. and Caulfield, Colm-cille P. and Alford, Matthew H. and Baker, Lois and Cael, B. B. and {Fern{\'a}ndez-Castro}, Bieito and {de Lavergne}, Casimir and Ellison, Elizabeth and Gebbie, Geoffrey and Gula, Jonathan and Heimbach, Patrick and Lanham, Joshua and Le Boyer, Arnaud and Oglethorpe, Kate and Peltier, W. Richard and Pillar, Helen R. and Piotrowski, Alexander M. and Purkey, Sarah G. and Reynard, Nick and Shuckburgh, Emily and Siegert, Martin J. and Silvano, Alessandro and Skinner, Luke C. and Spingys, Carl P. and Talley, Lynne D. and Taylor, John R. and Voet, Gunnar and Williams, Richard G. and Wilson, Chris and {Wynne-Cattanach}, Bethan L.},
  year = {2026},
  month = jul,
  journal = {Nat. Commun.},
  volume = {17},
  number = {1},
  pages = {5212},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-026-73809-3},
  urldate = {2026-07-09},
  abstract = {Small-scale turbulent mixing in the ocean interior is vital in governing ocean circulation and tracer distributions, and hence global climate. However, the planetary extent of this role and its dependence on the microphysics of mixing remain inadequately understood. Here, we emphasize the variety of spatio-temporal scales on which such interior turbulent mixing can shape the climate system. In addition to its well-established role in facilitating the equilibration of deep branches of ocean circulation on centennial-to-millennial timescales, interior turbulent mixing is a leading determinant of oceanic tracer budgets on timescales as short as sub-annual. We highlight the importance of the co-dependence of vertical (diapycnal) mixing and lateral (isopycnal) stirring in establishing the large-scale impacts of oceanic turbulence. We conclude with a summary of theoretical, observational and computational bottlenecks in the way of a sufficiently accurate representation of mixing in Earth System Models, and discuss emerging opportunities for making progress in these areas.},
  copyright = {2026 The Author(s)},
  langid = {english},
  keywords = {Ocean sciences,Physical oceanography}
}

@article{colosietal24,
  title = {On the Feasibility of Using Short-Range, High-Frequency Transmissions to Characterize the Vertical-Spectra of Small-Scale Internal Waves and Turbulence in a Bottom Boundary Layer},
  author = {Colosi, John A. and Duda, Timothy F. and Alford, Matthew and Lin, Ying-Tsong and Voet, Gunnar},
  year = {2024},
  month = mar,
  journal = {J. Acoust. Soc. Am.},
  volume = {155},
  number = {3\_Supplement},
  pages = {A278-A279},
  issn = {0001-4966},
  doi = {10.1121/10.0027497},
  urldate = {2025-07-01},
  abstract = {Using weak fluctuation theory, we examine the detectability of small-scale internal waves and turbulence via short-range, high-frequency transmissions to a vertical array. For internal waves the theory needs modification since the ranges of interest are shorter than the internal wave correlation lengths. The turbulence spectra are characterized by thermal dissipation, {$\chi$}, kinetic energy dissipation, {$\varepsilon$}, and outer scale L;0 (largest turbulent eddies) and regions of this space can be explored with different ranges and acoustic frequencies. Very little is known of the internal-wave structure when wave breaking starts. As an example, we consider an experimental arrangement atop the Atlantis 2 seamount where there is a strong, tidally driven boundary layer approximately 100-m thick.}
}

