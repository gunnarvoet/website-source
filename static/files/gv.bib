@article{alfordetal25,
  title = {Buoyancy {{Flux}} and {{Mixing Efficiency}} from {{Direct}}, {{Near-Bottom Turbulence Measurements}} in a {{Submarine Canyon}}},
  author = {Alford, Matthew H. and {Wynne-Cattanach}, Bethan and {Le Boyer}, Arnaud and Couto, Nicole and Voet, Gunnar and Spingys, Carl P. and {Fern{\'a}ndez-Castro}, Bieito and Forryan, Alex and {Naveira Garabato}, Alberto C. and {van Haren}, Hans},
  year = {2025},
  month = jan,
  journal = {J. Phys. Oceanogr.},
  volume = {55},
  number = {2},
  pages = {97--118},
  publisher = {American Meteorological Society},
  issn = {0022-3670, 1520-0485},
  doi = {10.1175/JPO-D-24-0005.1},
  urldate = {2025-01-31},
  abstract = {Turbulent kinetic energy and thermal variance dissipation rates {$\epsilon$} and {$\chi$}, buoyancy flux Jb, diffusivity {$\kappa\rho$}, and mixing coefficient {$\Gamma$}\textasciicircum{$\equiv$}Jb\,{$\epsilon-$}1, which is simply related to the mixing efficiency Rf=(1+{$\Gamma$}\textasciicircum -1)-1, are estimated from highly resolved microstructure measurements collected in a submarine canyon that has been previously shown to be experiencing near-bottom diapycnal upwelling. It is demonstrated that turbulence arises primarily from the convective instability of the internal tide. Twelve tidally resolving stations (12--48 h long) were conducted, wherein profiles were collected from between 5--15 m and 400 m above the bottom every 13--15 min using a custom turbulence vehicle. Turbulent buoyancy flux is estimated using the Osborn and Winters and D'Asaro methods, allowing direct estimation of the mixing coefficient as a function of time, temperature, and height above bottom. Turbulent dissipation and buoyancy flux generally increase toward the seafloor. The associated turbulent diapycnal diffusivity is 10-4--10-2 m2 s-1. Observed {$\Gamma$}\textasciicircum{} is {$\sim$}0.2 \textpm{} 0.05 near the top of our measurement range, as expected in the ocean interior, and increases to 0.3--0.7 approaching the bottom, consistent with turbulence generated by convective instability. Significance Statement We report detailed direct turbulence measurements very close to the seafloor in a submarine canyon that are well resolved enough in time to confidently understand the processes responsible for the turbulence. We compute the fraction of turbulent power that goes toward mixing, which is an important quantity to understand the role of turbulence in supporting the ocean's large-scale circulation.},
  chapter = {Journal of Physical Oceanography},
  langid = {english}
}

@article{alfordetal25a,
  title = {Observations of {{Turbulence Generated}} by a {{Near-Inertial Wave Propagating Downward}} in an {{Anticyclonic Eddy}}},
  author = {Alford, Matthew H. and Le Boyer, Arnaud and Ren, Alice S. and Voet, Gunnar and Bellerjeau, Charlotte and Whalen, Caitlin B. and Hall, Brendan and Couto, Nicole},
  year = {2025},
  journal = {Geophys. Res. Lett.},
  volume = {52},
  number = {6},
  pages = {e2024GL114070},
  issn = {1944-8007},
  doi = {10.1029/2024GL114070},
  urldate = {2025-03-21},
  abstract = {Two perpendicular microstructure turbulence and shipboard velocity sections were conducted at high horizontal resolution across an anticyclonic warm core ring. The observations showed elevated turbulence in the core of the eddy, coincident with regions of low Richardson number (Ri) \textbackslash (Ri)\textbackslash. Shear leading to the low Ri \textbackslash Ri\textbackslash{} was associated with a downward-propagating near-inertial wave that appeared to be trapped in the negative vorticity associated with the eddy, as has been found previously. The magnitude of the turbulence production agreed well with the vertical divergence of the vertical energy flux of the wave. The mixing coefficient of the turbulence was near 0.2, which together with the correlation with low Ri \textbackslash Ri\textbackslash{} suggests that shear instability drives the turbulence. A high shear-to-strain ratio of 10.3 was found, as expected for a shear-dominated near-inertial wave. Fine-structure parameterizations using strain only and both shear and strain overestimate the turbulence by factors of 2.7 and 12 respectively.},
  copyright = {\copyright{} 2025. The Author(s).},
  langid = {english}
}

@article{alfordetal25b,
  title = {A 90-m-{{Tall Neutrally Buoyant Instrument Chain}} for {{Measuring Ocean Fine Structure}} in a {{Quasi-Lagrangian Reference Frame}}},
  author = {Alford, Matthew H. and Thode, Aaron and Voet, Gunnar and Laferriere, Alison B. and {Le Boyer}, Arnaud and Couto, Nicole and Souhrada, Kevin and Bevans, Dieter and Berkenpas, Eric and Freeman, Lauren},
  year = {2025},
  month = apr,
  journal = {J. Atmos. Ocean. Technol.},
  volume = {42},
  number = {4},
  pages = {425--434},
  publisher = {American Meteorological Society},
  issn = {0739-0572, 1520-0426},
  doi = {10.1175/JTECH-D-24-0111.1},
  urldate = {2025-06-01},
  abstract = {Measurements from Lagrangian floats have enabled many advances in our understanding of small-scale ocean flows and their resulting turbulence. However, they lack the vertical span needed to fully contextualize the flow. As a compromise, a 90-m-tall, neutrally buoyant drifting instrumented system was designed and tested. An adaptive buoyancy engine ensures the system stays within a preset depth range while dangling a densely instrumented thermistor chain and an upward-looking 300-kHz ADCP. Once the system reaches its target depth, the buoyancy engine shuts down. The system then follows isopycnals, drifting laterally and vertically with the mean flow averaged over its vertical extent. This reference frame offers a unique view of the evolving shear and strain fields. Preliminary observations and interpretations demonstrate the system's usefulness and provide a detailed view of near-inertial and high-frequency internal waves and their estimated mixing. Significance Statement We have built and tested a new instrument consisting of a Doppler current profiler inside a neutrally buoyant float and a dangling vertical string of closely spaced temperature sensors. The system allows investigation of the small-scale breaking waves that lead to ocean turbulence while drifting with the waves as they are swept along with the background flow. Understanding the details of how these motions lead to ocean mixing is important to improving climate simulations.},
  chapter = {Journal of Atmospheric and Oceanic Technology},
  langid = {english},
  keywords = {Instrumentation/sensors,Internal waves,Ocean,Turbulence}
}

@article{alfordetal26,
  title = {Ground-{{Truthed Fiber-Optic Sensing Reveals Internal Tide Bores Over Madeira}}'s {{Steep Slope}}},
  author = {Alford, Matthew H. and Belal, Mohammad and Naveira Garabato, Alberto C. and Spingys, Carl and Voet, Gunnar and Godin, Oleg A. and Uzhansky, Ernst M. and Neale, Jennifer Ward and Reis, Jesus and Loureiro, Afonso},
  year = {2026},
  journal = {Geophys. Res. Lett.},
  volume = {53},
  number = {13},
  pages = {e2026GL124117},
  issn = {1944-8007},
  doi = {10.1029/2026GL124117},
  urldate = {2026-07-08},
  abstract = {We demonstrate the combined utility of distributed acoustic sensing (DAS) and repeat conductivity-temperature-depth (CTD) profiling for observing internal tide dynamics over a sloping seafloor. While DAS has been widely proposed as a method to infer ocean temperature variability from seafloor cables, quantitative in situ validation has been limited. Here we present the first published detailed comparison between DAS-inferred bottom temperature fluctuations and near-bottom temperature measured from high-resolution yoyo-CTD time series reaching 5 m above the seafloor, conducted over the EllaLink/GeoLab cable on the slope of Madeira. Linear regressions yield an empirical DAS temperature sensitivity of 21--37 \textmu strain \textbraceleft\textbackslash mathrmK\textasciicircum -1\textbackslash, a factor 2.5--4 greater than commonly used theoretical estimates. The calibrated DAS record reveals semidiurnal internal tide bores propagating upslope to \textbraceleft\textbackslash sim \textbackslash 1,300 m depth, where propagation halts and transitions to a complex interference pattern. These observations highlight the potential of combining seafloor fiber sensing with targeted in situ profiling to observe near-bottom internal tide breaking processes.},
  langid = {english},
  keywords = {climate change,coral reef,hydrodynamics,Marine heat wave,ocean temperature,sea level rise}
}

